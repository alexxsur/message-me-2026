</div>

<div class="container text-center">
  <div class="row">
    <div class="col col-8">
      <div class="card">
        <div class="card-body">
          <div class="p-3">
            <ul class="list-unstyled d-flex flex-column gap-3 text-start">
              <li>
                <a href="#" class="text-decoration-none">Elliot Fu</a> added
