<div class="container text-center">
  <div class="row">
    <div class="col col-8">
      <div class="card">
        <div class="card-body">
          <div id="messages-container" class="chatroom-messages p-3">
            <ul id="messages" class="list-unstyled d-flex flex-column gap-3 text-start">
              <%= render @messages %>
            </ul>
          </div>
        </div>
        <div class="card-footer text-body-secondary">
          <%= form_with model: Message.new, url: messages_path, class: "input-group", data: { action: "turbo:submit-end->chat-form#reset", controller: "chat-form" } do |f| %>
            <%= f.text_field :body, class: "form-control", placeholder: "Enter a message...", "aria-label": "Enter a message...", autocomplete: "off", required: true %>
            <%= f.button type: "submit", class: "btn chatroom-send-button", "aria-label": "Send" do %>
              <i class="bi bi-pencil-square"></i>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col col-4">
      <div class="card">
        <div class="card-body">
          <div class="list-group" data-bs-theme="dark">
            <a href="#" class="list-group-item list-group-item-action d-flex">Online Users</a>
            <a href="#" class="list-group-item list-group-item-action d-flex">Home</a>
            <a href="#" class="list-group-item list-group-item-action d-flex">Messages</a>
            <a href="#" class="list-group-item list-group-item-action d-flex">Friends</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>